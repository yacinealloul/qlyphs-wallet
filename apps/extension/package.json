    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.5",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.28.2",
    "jsqr": "^1.4.0",
    "typescript": "~6.0.3"
  }
}
